# Токен Telegram бота (обязательно)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Настройки базы данных
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=study_assist
DB_SSL_MODE=disable

# Настройки пула соединений
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFETIME=1h
